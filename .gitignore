# --- Environments -----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Data: NEVER tracked in git. Versioned with DVC (gs:// remote) ----------
# Inputs (downloaded//prepared structures) and outputs (energies, decoys, tables)
data/
results/
*.pdb
*.cif
*.csv
*.parquet
!tests/**/*.pdb          # tiny hand-built fixtures ARE code, and stay in git

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.dvc/cache
.dvc/tmp
